# Modelo de Variáveis de Ambiente - MEGAMANIA 8-bit
# Copie este arquivo para .env e preencha as chaves reais se for utilizar APIs externas.

# Servidor & Ambiente
PORT=3000
NODE_ENV=development

# Configurações do Jogo (Exemplo)
GAME_TITLE="MEGAMANIA 8-bit"
MAX_LIVES=3
ENABLE_ANALYTICS=false

# Exemplo de credenciais de API (NÃO INCLUA CHAVES REAIS NO REPOSITÓRIO)
# API_KEY=sua_chave_aqui
# ANALYTICS_ID=seu_id_aqui
